rules_version = '2';

// Firestore security rules for C00K90. This file is the source of truth: change the rules
// here, then publish them with `firebase deploy --only firestore:rules` from the backend
// folder, or paste them into Firebase Console → Firestore Database → Rules.
// (Matches the rules published in the console on 12 Nov 2026.)
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins (Alexandra and Adrian) can read feedback and reports and hide shared recipes.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['YNeChEaSuUYQMKxsuiJfA4CKp9J2', 'E5UJm2sOUSRBDaeB5fEb47wRyva2'];
    }

    // Recipes: owners manage their own; shared recipes are readable by every signed-in user.
    // Only an admin can hide a shared recipe (hiddenByModerator), and owners can't undo it.
    match /recipes/{recipeId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || resource.data.shared == true);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenByModerator'])
        && (request.resource.data.get('hiddenByModerator', false) == false || request.resource.data.get('shared', false) == false);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared', 'hiddenByModerator']);
    }

    // Feedback and reports: anyone signed in can send one; only admins read them.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Private, one document per user (document id = the user's id).
    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public chef profiles: readable by everyone signed in, written only by the chef.
    match /chefs/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
          ['displayName', 'photoUrl', 'facebook', 'instagram', 'tiktok', 'youtube', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /follows/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /collections/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /mealPlans/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
