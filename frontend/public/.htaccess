# Apache config for cookbook.antdevlabs.com (cPanel). Copied into the build output by Angular.
RewriteEngine On

# Always use HTTPS (needed for Firebase sign-in and the PWA).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve real files and folders as-is; send every other path to Angular's router.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

# index.html must never be cached, so a new deploy shows up right away.
# The JS/CSS files have a hash in their name, so they can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[0-9A-Z]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
